# Copy to .env for local development. NEVER commit a real .env.
# The production copy of these variables lives in the Render dashboard
# (Environment section) — values there must never be pasted into chat,
# screenshots, or this repository.

# --- Required ---

# PostgreSQL connection string (local or hosted, e.g. Aiven). Tests and the
# server both read this. Never point `npm test` at a production database.
DATABASE_URL="postgres://user:password@host:port/dbname?sslmode=require"

# JWT signing secret. Must be a long random string (32+ hex/bytes), NOT a
# number. The server refuses to start without it. On Render, generate a new
# random value and keep it secret; rotating it invalidates all sessions.
JWT_SECRET="replace-with-a-long-random-hex-string"

# --- Optional ---

# Port the HTTP server listens on. Render assigns this automatically via the
# PORT environment variable — do NOT hardcode or override it in the Render
# dashboard unless you know the platform binding matches. Local default: 3000.
# PORT=3000

# "production" enables SameSite=None; Secure cookies (required for a
# cross-origin Vercel -> Render setup). Anything else keeps SameSite=Strict
# development cookies. Set NODE_ENV=production on Render (K18).
# NODE_ENV=production

# Comma-separated list of ALLOWED frontend origins (scheme + host [+ port],
# no path, no trailing slash required — trailing slashes are stripped).
# These are ORIGINS, not API URLs. Example once the frontend is deployed:
# ALLOWED_ORIGINS="https://your-frontend.vercel.app"
# Multiple: ALLOWED_ORIGINS="https://app.vercel.app,https://admin.example.com"
# Unset/empty -> localhost dev defaults. A value that parses to an empty
# list rejects ALL cross-origin requests (fail-closed).
# ALLOWED_ORIGINS="http://localhost:5173"
